{
  "name": "@adonis-agora/media-dashboard",
  "version": "10.0.0-rc.7",
  "description": "Media-management dashboard for @adonis-agora/media — browse buckets, watch resumable uploads in progress, upload, and copy/move/delete objects across buckets. A React SPA served by a thin AdonisJS provider, themed to Agora design tokens. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-media.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://davidecarvalho.github.io/agora/docs/media",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-agora-media/issues"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "media",
    "dashboard",
    "admin",
    "console",
    "s3",
    "buckets",
    "upload",
    "resumable",
    "agora",
    "tanstack-intent"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "sideEffects": [
    "*.css",
    "./src/agora-kit/fonts.ts"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit"
  },
  "devDependencies": {
    "@adonis-agora/filter-client": "1.0.0-rc.1",
    "@adonis-agora/media-react": "workspace:*",
    "@base-ui/react": "1.9.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/intent": "0.5.6",
    "@tanstack/react-query": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
