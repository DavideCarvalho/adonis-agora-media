{
  "name": "@adonis-agora/media-dashboard",
  "version": "0.1.0",
  "description": "Media-management dashboard for @adonis-agora/media — browse buckets, watch resumable uploads in progress, upload, and copy/move/delete objects across buckets. A React SPA served by a thin AdonisJS provider, themed to Agora design tokens. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-media.git",
    "directory": "packages/dashboard"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./media_dashboard_provider": {
      "types": "./dist/provider/media_dashboard_provider.d.ts",
      "import": "./dist/provider/media_dashboard_provider.js",
      "default": "./dist/provider/media_dashboard_provider.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit"
  },
  "peerDependencies": {
    "@adonis-agora/media": "^0.1.0",
    "@adonisjs/core": "^7.3.0"
  },
  "devDependencies": {
    "@adonis-agora/media": "workspace:*",
    "@adonis-agora/media-react": "workspace:*",
    "@adonisjs/core": "^7.3.0",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "media",
    "dashboard",
    "admin",
    "console",
    "s3",
    "buckets",
    "upload",
    "resumable",
    "agora"
  ]
}
