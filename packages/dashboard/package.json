{
  "name": "@adonis-agora/media-dashboard",
  "version": "8.0.2",
  "description": "Media-management dashboard for @adonis-agora/media — browse buckets, watch resumable uploads in progress, upload, and copy/move/delete objects across buckets. A React SPA served by a thin AdonisJS provider, themed to Agora design tokens. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-media.git",
    "directory": "packages/dashboard"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./media_dashboard_provider": {
      "types": "./dist/provider/media_dashboard_provider.d.ts",
      "import": "./dist/provider/media_dashboard_provider.js",
      "default": "./dist/provider/media_dashboard_provider.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit"
  },
  "peerDependencies": {
    "@adonis-agora/media": ">=0.11.0 <1.0.0",
    "@adonisjs/core": "^7.3.0"
  },
  "devDependencies": {
    "@adonis-agora/media": "npm:@adonis-agora/media@0.11.0",
    "@adonis-agora/media-react": "workspace:*",
    "@adonisjs/core": "7.5.0",
    "@base-ui/react": "1.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/intent": "^0.3.7",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "media",
    "dashboard",
    "admin",
    "console",
    "s3",
    "buckets",
    "upload",
    "resumable",
    "agora",
    "tanstack-intent"
  ]
}
