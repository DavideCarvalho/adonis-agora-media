import { defineConfig } from '@adonis-agora/media/dashboard'

/**
 * Configuration for the @adonis-agora/media dashboard -- a management console (React SPA + JSON API)
 * embedded in this same package, mounted by '@adonis-agora/media/dashboard_provider' (registered by
 * 'configure' above). Storage, uploads and everything else come from the already-configured
 * @adonis-agora/media manager; this config only places the console and picks which disks are browsable.
 *
 * 'authorize' decides who may open the console. Until you set it, the console is open outside production
 * and its pages and API answer 403 in production. It takes a function, a class with an
 * 'authorize(ctx)' method, or a lazy import of one: () => import('#policies/console_access').
 * Sign-in is this app's own: return { redirectTo: '/login' } to send a signed-out visitor there.
 *
 * The console is a READ-ONLY browser by default. Flip 'actions' on to enable copy/move/delete.
 */
export default defineConfig({
  // enabled: true,
  // basePath: '/media/dashboard',
  // apiBasePath: '/media/dashboard/api',
  // actions: true,
  // disks: ['s3', 'backups'],           // default: derived from config/media.ts
  // authorize: (ctx) => ctx.auth.user?.isAdmin === true, // who may open it — SPA + API
  // middleware: middleware.auth(),      // runs after authorize

  // Where the 'url' the console reports for an object points: 'auto' signs a URL straight
  // to the store; 'proxy' routes it through this app's own '<apiBasePath>/object/raw'. Use 'proxy'
  // when the store is not reachable from a browser (private bucket / internal hostname / no CORS) --
  // a signed URL for an internal endpoint resolves nowhere in a browser. When unset, the console
  // follows config/media.ts: 'delivery.mode: proxy' there implies 'proxy' here.
  // objectUrls: 'proxy',
})
