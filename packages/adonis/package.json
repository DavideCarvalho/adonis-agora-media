{
  "name": "@adonis-agora/media",
  "version": "0.1.0",
  "description": "Media-library for AdonisJS — owner collections (MIME whitelist, single-file replace, ordering), image conversions (eager/lazy), and column attachments, all on top of @adonisjs/drive. Pluggable MediaStore (in-memory + Lucid) and ImageProcessor (sharp). Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-media.git",
    "directory": "packages/adonis"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./media_provider": {
      "types": "./dist/providers/media_provider.d.ts",
      "import": "./dist/providers/media_provider.js",
      "default": "./dist/providers/media_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    },
    "./stores/lucid": {
      "types": "./dist/src/stores/lucid.d.ts",
      "import": "./dist/src/stores/lucid.js",
      "default": "./dist/src/stores/lucid.js"
    },
    "./processors/sharp": {
      "types": "./dist/src/processors/sharp.d.ts",
      "import": "./dist/src/processors/sharp.js",
      "default": "./dist/src/processors/sharp.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js",
      "default": "./dist/src/testing/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "copy:stubs": "mkdir -p dist/stubs/config dist/stubs/database/migrations && cp stubs/config/media.stub dist/stubs/config/media.stub && cp -r stubs/database/migrations/. dist/stubs/database/migrations/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/drive": "^3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "sharp": "^0.33.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/drive": "^3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "@types/node": "^20.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "media",
    "media-library",
    "drive",
    "storage",
    "uploads",
    "image",
    "conversions",
    "sharp",
    "attachment",
    "agora"
  ]
}
