{
  "name": "@adonis-agora/media",
  "version": "0.10.2",
  "description": "Media-library for AdonisJS — owner collections (MIME whitelist, single-file replace, ordering), image conversions (eager/lazy), pluggable content transformers (HLS video via mediabunny, metadata probe), and column attachments, all on top of @adonisjs/drive. Pluggable MediaStore (in-memory + Lucid) and ImageProcessor (sharp). Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-media.git",
    "directory": "packages/adonis"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./services/main": {
      "types": "./dist/src/services/main.d.ts",
      "import": "./dist/src/services/main.js",
      "default": "./dist/src/services/main.js"
    },
    "./single-file": {
      "types": "./dist/src/single_file_store.d.ts",
      "import": "./dist/src/single_file_store.js",
      "default": "./dist/src/single_file_store.js"
    },
    "./media_provider": {
      "types": "./dist/providers/media_provider.d.ts",
      "import": "./dist/providers/media_provider.js",
      "default": "./dist/providers/media_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    },
    "./stores/lucid": {
      "types": "./dist/src/stores/lucid.d.ts",
      "import": "./dist/src/stores/lucid.js",
      "default": "./dist/src/stores/lucid.js"
    },
    "./upload_sessions/lucid": {
      "types": "./dist/src/upload_sessions/lucid.d.ts",
      "import": "./dist/src/upload_sessions/lucid.js",
      "default": "./dist/src/upload_sessions/lucid.js"
    },
    "./disks/s3": {
      "types": "./dist/src/disks/s3.d.ts",
      "import": "./dist/src/disks/s3.js",
      "default": "./dist/src/disks/s3.js"
    },
    "./processors/sharp": {
      "types": "./dist/src/processors/sharp.d.ts",
      "import": "./dist/src/processors/sharp.js",
      "default": "./dist/src/processors/sharp.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js",
      "default": "./dist/src/testing/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./telescope": {
      "types": "./dist/src/telescope/index.d.ts",
      "import": "./dist/src/telescope/index.js",
      "default": "./dist/src/telescope/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "copy:stubs": "mkdir -p dist/stubs/config dist/stubs/database/migrations && cp stubs/config/media.stub dist/stubs/config/media.stub && cp -r stubs/database/migrations/. dist/stubs/database/migrations/",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@adonis-agora/telescope": "^0.4.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/drive": "^3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "mediabunny": "^1.45.4",
    "sharp": "^0.33.0"
  },
  "peerDependenciesMeta": {
    "@adonis-agora/telescope": {
      "optional": true
    },
    "mediabunny": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/drive": "^3.0.0",
    "@adonisjs/lucid": "^22.4.0",
    "@aws-sdk/client-s3": "^3.726.1",
    "@smithy/util-stream": "^3.3.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "better-sqlite3": "^11.0.0",
    "luxon": "^3.4.0",
    "mediabunny": "^1.50.9",
    "sharp": "^0.33.0",
    "tempura": "0.4.1",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "media",
    "media-library",
    "drive",
    "storage",
    "uploads",
    "image",
    "conversions",
    "transformers",
    "video",
    "hls",
    "mediabunny",
    "sharp",
    "attachment",
    "agora"
  ]
}
